# This .gitignore file should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emps/
/[Oo]bj/
/[Bb]uilds/
/[Bb]uild/
/[Ll]ogs/
/[Mm]emoryCaptures/

# Assetco temporary caches
/[Aa]ssets/[Aa]ssetStoreTools/

# Autogenerated Visual Studio and MonoDevelop files
ExportedObj/
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Packed Addressables
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Temporary files
*.rsuser
*.fileList
*.lock